KAVACH_ENVIRONMENT=development
KAVACH_DATABASE_URL=sqlite:///.data/kavach.db
# Required in production: generate with python -c "import secrets; print(secrets.token_urlsafe(48))"
# KAVACH_JWT_SECRET=
KAVACH_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
KAVACH_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
KAVACH_ACCESS_TOKEN_MINUTES=15
KAVACH_REFRESH_TOKEN_DAYS=7
KAVACH_HISTORY_RETENTION_DAYS=30
KAVACH_RATE_LIMIT_PER_MINUTE=90
KAVACH_SCAN_LIMIT_PER_MINUTE=10
KAVACH_MAX_CONCURRENT_SCANS=8
# DNSBL providers have usage and licensing rules. Set only zones you may query.
KAVACH_DNSBL_ZONES=[]
